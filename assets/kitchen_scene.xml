<!--
  Kitchen scene: a Unitree G1 (fixed base, Dex3 hands, virtual 2-DOF neck)
  standing behind a kitchen island with some objects to play with.

  Coordinates (meters):  +x = the direction the robot faces
                         +y = the robot's left
                         +z = up
  The robot's pelvis is at (0, 0, 0.793). The countertop surface is at z = 0.70.
-->
<mujoco model="g1_kitchen">
  <include file="g1_dex3_fixed.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10" noslip_iterations="3"/>

  <statistic center="0.25 0 0.9" extent="1.6"/>

  <visual>
    <global offwidth="1600" offheight="1200" azimuth="180" elevation="-20"/>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <quality shadowsize="2048"/>
    <map znear="0.01"/>
  </visual>

  <default>
    <!-- everything that is part of the room and never moves -->
    <default class="furniture">
      <geom type="box" condim="3" friction="0.8 0.01 0.001"/>
    </default>
    <!-- things the robot can pick up -->
    <default class="object">
      <geom condim="4" friction="1.5 0.02 0.002" solimp="0.95 0.99 0.001" density="400"/>
    </default>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.95 0.95 0.92" rgb2="0.75 0.78 0.80" width="512" height="3072"/>
    <texture name="floor_tiles" type="2d" builtin="checker" rgb1="0.86 0.83 0.78" rgb2="0.78 0.75 0.70"
             mark="edge" markrgb="0.62 0.60 0.57" width="512" height="512"/>
    <texture name="wood" type="2d" builtin="flat" rgb1="0.52 0.36 0.22" mark="random" random="0.12"
             markrgb="0.42 0.28 0.16" width="512" height="512"/>
    <texture name="stone" type="2d" builtin="flat" rgb1="0.80 0.80 0.78" mark="random" random="0.05"
             markrgb="0.70 0.70 0.70" width="512" height="512"/>

    <material name="floor" texture="floor_tiles" texuniform="true" texrepeat="3 3"/>
    <material name="wall" rgba="0.93 0.91 0.86 1"/>
    <material name="cabinet" texture="wood" texuniform="true" texrepeat="2 2"/>
    <material name="cabinet_light" rgba="0.82 0.85 0.86 1"/>
    <material name="countertop" texture="stone" texuniform="true" texrepeat="2 2"/>
    <material name="handle" rgba="0.25 0.25 0.27 1" specular="0.8" shininess="0.8"/>
    <material name="cutting_board" rgba="0.80 0.62 0.40 1"/>
  </asset>

  <worldbody>
    <!-- ======================= lights ======================= -->
    <light name="sun" pos="1.5 0.5 3.0" dir="-0.15 -0.1 -1" directional="true" diffuse="0.45 0.45 0.42" castshadow="true"/>
    <light name="island_lamp_left" pos="0.5 0.4 2.2" dir="0 0 -1" diffuse="0.35 0.33 0.30" castshadow="false" attenuation="1 0 0"/>
    <light name="island_lamp_right" pos="0.5 -0.4 2.2" dir="0 0 -1" diffuse="0.35 0.33 0.30" castshadow="false" attenuation="1 0 0"/>

    <!-- ======================= room ======================= -->
    <geom name="floor" type="plane" size="0 0 0.05" material="floor" condim="3"/>
    <geom name="back_wall" class="furniture" pos="-0.95 0 1.3" size="0.02 2.5 1.3" material="wall"/>
    <geom name="side_wall" class="furniture" pos="0.9 -2.5 1.3" size="1.9 0.02 1.3" material="wall"/>
    <geom name="side_wall_2" class="furniture" pos="0.9 2.5 1.3" size="1.9 0.02 1.3" material="wall"/>
    <!-- the wall the robot is looking at (behind the kitchen camera) -->
    <geom name="front_wall" class="furniture" pos="2.8 0 1.3" size="0.02 2.5 1.3" material="wall"/>
    <geom name="window" class="furniture" pos="2.77 0.6 1.45" size="0.01 0.55 0.45" rgba="0.70 0.85 0.95 1" contype="0" conaffinity="0"/>
    <geom name="window_frame" class="furniture" pos="2.775 0.6 1.45" size="0.008 0.59 0.49" rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>
    <geom name="clock" class="furniture" type="cylinder" pos="2.77 -0.9 1.75" euler="0 1.5708 0" size="0.15 0.01" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>
    <geom name="clock_face" class="furniture" type="cylinder" pos="2.758 -0.9 1.75" euler="0 1.5708 0" size="0.13 0.005" rgba="0.97 0.97 0.95 1" contype="0" conaffinity="0"/>

    <!-- upper cabinets on the back wall (behind the robot's head) -->
    <geom name="upper_cabinets" class="furniture" pos="-0.78 0 1.85" size="0.17 1.6 0.35" material="cabinet_light"/>
    <geom name="upper_cabinet_handle_1" class="furniture" pos="-0.605 0.45 1.6" size="0.008 0.06 0.008" material="handle"/>
    <geom name="upper_cabinet_handle_2" class="furniture" pos="-0.605 -0.45 1.6" size="0.008 0.06 0.008" material="handle"/>
    <geom name="range_hood" class="furniture" pos="-0.70 0 1.45" size="0.25 0.40 0.05" rgba="0.6 0.62 0.64 1"/>

    <!-- refrigerator off to the side -->
    <geom name="fridge" class="furniture" pos="-0.55 -1.9 0.95" size="0.37 0.45 0.95" rgba="0.78 0.80 0.82 1"/>
    <geom name="fridge_handle" class="furniture" pos="-0.17 -1.6 1.15" size="0.01 0.01 0.25" material="handle"/>

    <!-- ======================= kitchen island ======================= -->
    <!-- The robot stands behind it (on the -x side) and works on the countertop.
         The G1 is only 1.32 m tall, so the counter is 0.70 m high (for a 1.75 m adult
         that would feel like a normal 0.93 m kitchen counter). -->
    <body name="island" pos="0.42 0 0">
      <geom name="island_toe_kick" class="furniture" pos="0 0 0.05" size="0.22 0.72 0.05" rgba="0.2 0.2 0.2 1"/>
      <geom name="island_cabinet" class="furniture" pos="0 0 0.38" size="0.27 0.75 0.28" material="cabinet"/>
      <geom name="countertop" class="furniture" pos="0 0 0.68" size="0.30 0.80 0.02" material="countertop"/>
      <!-- cabinet doors + handles on the side facing the kitchen camera -->
      <geom class="furniture" pos="0.272 0.375 0.38" size="0.004 0.355 0.26" rgba="0.48 0.33 0.20 1" contype="0" conaffinity="0"/>
      <geom class="furniture" pos="0.272 -0.375 0.38" size="0.004 0.355 0.26" rgba="0.48 0.33 0.20 1" contype="0" conaffinity="0"/>
      <geom class="furniture" pos="0.28 0.05 0.52" size="0.008 0.008 0.07" material="handle" contype="0" conaffinity="0"/>
      <geom class="furniture" pos="0.28 -0.05 0.52" size="0.008 0.008 0.07" material="handle" contype="0" conaffinity="0"/>
      <!-- cutting board (part of the counter, does not move); the banana sits on it -->
      <geom name="cutting_board" class="furniture" pos="-0.06 -0.26 0.708" size="0.08 0.11 0.008" material="cutting_board"/>
      <!-- a shallow tray: a good place to drop things into -->
      <geom name="tray_bottom" class="furniture" pos="-0.06 0.0 0.704" size="0.07 0.10 0.004" rgba="0.25 0.45 0.65 1"/>
      <geom name="tray_wall_front" class="furniture" pos="0.01 0.0 0.72" size="0.004 0.10 0.02" rgba="0.25 0.45 0.65 1"/>
      <geom name="tray_wall_back" class="furniture" pos="-0.13 0.0 0.72" size="0.004 0.10 0.02" rgba="0.25 0.45 0.65 1"/>
      <geom name="tray_wall_left" class="furniture" pos="-0.06 0.10 0.72" size="0.07 0.004 0.02" rgba="0.25 0.45 0.65 1"/>
      <geom name="tray_wall_right" class="furniture" pos="-0.06 -0.10 0.72" size="0.07 0.004 0.02" rgba="0.25 0.45 0.65 1"/>
    </body>

    <!-- ======================= objects on the counter ======================= -->
    <!-- Each object has a <freejoint/>, which means it can fall, slide, and be picked up.
         They are all within reach: the G1's wrist can only get about 25 cm in front of
         its body at counter height. -->
    <body name="red_cube" pos="0.24 0.17 0.726">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube" class="object" type="box" size="0.025 0.025 0.025" rgba="0.85 0.15 0.15 1"/>
    </body>
    <body name="green_cube" pos="0.22 0.02 0.726">
      <freejoint name="green_cube_joint"/>
      <geom name="green_cube" class="object" type="box" size="0.025 0.025 0.025" rgba="0.20 0.70 0.25 1"/>
    </body>
    <body name="blue_cube" pos="0.23 -0.14 0.726">
      <freejoint name="blue_cube_joint"/>
      <geom name="blue_cube" class="object" type="box" size="0.025 0.025 0.025" rgba="0.20 0.35 0.85 1"/>
    </body>
    <body name="apple" pos="0.32 0.20 0.736">
      <freejoint name="apple_joint"/>
      <geom name="apple" class="object" type="sphere" size="0.035" rgba="0.80 0.10 0.10 1"/>
      <geom class="object" type="capsule" pos="0 0 0.038" size="0.003 0.008" rgba="0.35 0.22 0.10 1" density="0"/>
    </body>
    <body name="soda_can" pos="0.22 -0.30 0.761">
      <freejoint name="soda_can_joint"/>
      <geom name="soda_can" class="object" type="cylinder" size="0.03 0.06" rgba="0.75 0.75 0.80 1"/>
      <geom class="object" type="cylinder" pos="0 0 0" size="0.0305 0.035" rgba="0.80 0.10 0.15 1" contype="0" conaffinity="0" density="0"/>
    </body>
    <body name="mug" pos="0.25 0.30 0.746">
      <freejoint name="mug_joint"/>
      <geom name="mug" class="object" type="cylinder" size="0.035 0.045" rgba="0.95 0.95 0.92 1"/>
      <geom name="mug_handle" class="object" type="capsule" pos="0 -0.048 0" size="0.008 0.025" rgba="0.95 0.95 0.92 1"/>
    </body>
    <body name="banana" pos="0.33 -0.23 0.735" euler="1.5708 0 0">
      <freejoint name="banana_joint"/>
      <geom name="banana" class="object" type="capsule" size="0.018 0.06" rgba="0.95 0.85 0.20 1"/>
    </body>

    <!-- ======================= cameras ======================= -->
    <!-- fixed view from across the island, looking at the robot (press K in the app to use it) -->
    <camera name="kitchen_cam" pos="2.1 0.0 1.6" xyaxes="0 1 0 -0.35 0 0.94" fovy="45"/>

  </worldbody>
</mujoco>
